# Copy to compose/.env (optional; every value has a default).

# Pin: MUST equal the upstream submodule tag (scripts/check-pins.sh enforces it).
MULTICA_IMAGE_TAG=v0.10.0

# Required by the stock backend. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me

# TEST HARNESS ONLY: lets bootstrap.sh sign in without email. Never set these
# on a real deployment (the server ignores the code when APP_ENV=production).
APP_ENV=development
MULTICA_DEV_VERIFICATION_CODE=888888
BOOTSTRAP_EMAIL=bb-admin@example.com

# Shared secret between the daemon and (mock-)bb.
MULTICA_BB_TOKEN=local-bb-token

# Phase 2: point at a real bb staging Worker instead of mock-bb.
# MULTICA_BB_ENDPOINT=https://bb-staging.example.workers.dev
MULTICA_BB_SILENCE_TIMEOUT=2m
